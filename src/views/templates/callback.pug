include ../helpers/mixins.pug
div.modal
    form
        .modal__title
            h3 Заказать звонок
        .modal__content
            .modal__item
                .call-form__title.modal__item-title Где вам удобно общаться?
                .call-form__via
                            label(for="tele")
                                input#tele(type="radio" name="via" checked="checked")
                                .title Телефон
                            label(for="wap")
                                input#wap(type="radio" name="via")
                                .title WhatsApp
                            label(for="tg")
                                input#tg(type="radio" name="via")
                                .title Telegram
            .modal__item
                .call-form__title.modal__item-title Номер телефона
                .call-form__group
                        .call-form__input
                            input(type="tel" placeholder="Введите номер" name="tel" required="required" data-maska="+7(###)###-##-##")
            .modal__item
                button.btn.btn-green.btn-wide(type="submit")
                    span Жду звонок
                .call-form__input.subtitle
                            +checkbox("", "agree", {required: true})
                                span.subtitle-text
                                    span Нажимая на кнопку, вы соглашаетесь с нашими
                                    a(href='#' target="_blank")  «Правилами обработки персональных данных»
