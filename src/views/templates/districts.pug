include ../helpers/mixins

.districts-popup
    .districts-popup__header
        h3.districts-popup__title Выберите районы
        .input-filter
            +icons("#ic_search",28,"icon-search")
            input(type="text", placeholder="Название района")
            button &times;
    form.districts-popup__body
        .districts-popup__instant
            h5 Быстрый выбор района
            ul#instants
        .districts-popup__areas
            h4 Административные округа
            ul#areas
        .districts-popup__districts
            h4 Районы
            div#districts
    .btn-wrapper
        button(type="submit").btn.btn-green
            span Показать подходящие объекты
        button(type="reset").btn.btn-transparent.btn-reset
            span Сбросить
            +icons("#ic_close")
