extends ../layouts/page

block variables
    - const title = "Городская недвижимость - Metrium"
    - const pageUrl = "/city.html"

block main
    .city-map
        #loader.loader-wrapper.abs
            .loader
        #city-map
        .city-map__controls
            button.btn.btn-gold(data-target=".city-map__filters" data-toggle="sm-modal")
                +icons('#ic_filters')
                span Фильтры
            .buttons-group
                a.btn.grid(href="/city.html")
                    +icons("#ic_grid")
                    span Плиткой
                a.btn.hide-before-xl.list(href="/city.html?view=list")
                    +icons("#ic_list")
                    span Списком
                a(href="/city-map.html").btn.active.hide-before-xl
                    +icons("#ic_on-map-small")
                    span На карте
        .city-map__filters.page-title__filter
            include ../../blocks/modules/page-filter/page-filter
        .city-map__list
            .container
                .city-map__list-header
                    h4 Подходящие варианты
                    button.close(data-target=".city-map__list" data-toggle="open")
                        +icons("#ic_close", 12)
                #city-map-results

block append scripts
    script(src="https://api-maps.yandex.ru/v3/?apikey=0e00c58a-2691-4220-95a9-f61fbbb73582&lang=ru_RU")
