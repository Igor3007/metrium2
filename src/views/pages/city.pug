extends ../layouts/page

include ../../blocks/components/breadcrumbs/breadcrumbs
include ../../blocks/modules/special-offers/special-offers
include ../../blocks/modules/form-question/form-question
include ../../blocks/modules/recently-viewed/recently-viewed

block variables
    - const title = "Городская недвижимость - Metrium"
    - const pageUrl = "/city.html"

block main
    include ../../blocks/modules/page-title/page-title--city
    include ../../blocks/modules/estate-list/estate-list
    +special-offers({title: "Подборки городской недвижимости", class: "city-page"})
    +recently-viewed()
    +form-question({
        title: "Затрудняетесь с выбором?",
        description: "Эксперты «Метриум Премиум» помогут вам и сэкономят время без предоплаты и комиссии!",
        class: "slim dark-bg"
    })
    section.seo-text.city-page
        .container
            h3 Покупка элитной квартиры: преимущества
            p Несколько веков назад вся территория Москвы умещалась внутри Садового кольца.
                |Сегодня это исторический центр, кажущийся совсем небольшим по сравнению с разросшимся мегаполисом.
                |И как ни странно, но именно центр – самая уютная его часть.
                |Стоит свернуть с Садового кольца вглубь, и темпы большого города замедляются.
                |Набережная Москвы-реки, старинные особняки, тихие скверы, ухоженные парки, златоглавые соборы,
                |знаменитые памятники и музеи делают прогулки по центру приятными в любое время года.
                |Помимо сосредоточения архитектурных и культурных памятников, этот район знаменит тем,
                |что здесь сконцентрированы самые престижные квартиры в Москве.
                |Власти столицы прикладывают усилия, чтобы сохранить центр в его первоначальном виде
                |и при этом сделать максимально комфортным для жизни.
                |Неслучайно купить элитную квартиру в центре Москвы стремятся как состоятельные бизнесмены и политики,
                |так и знаменитые артисты.
            h3 Для тех, кто привык быть в центре: продажа элитного жилья в Москве
            p Цены на недвижимость Москвы разнообразны, как и сами варианты жилья.
                |В базе компании «Метриум Премиум» есть как реконструированные особняки, так и новые дома.
                |Что вам по душе? Старинные здания, высокие потолки которых помнят звуки романсов,
                |а стены хранят истории прошлого? Новостройки бизнес-класса и клубные дома,
                |оснащенные по последнему слову техники? Или головокружительный небоскрёб,
                |зеркальные стены которого отражаются в водах Москвы-реки?
                |Каждый из объектов уникален, обладает своей атмосферой и рядом особенных преимуществ.

