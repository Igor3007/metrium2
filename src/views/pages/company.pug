extends ../layouts/page

include ../../blocks/modules/our-services/our-services

block variables
    - const title = "О компании - Metrium"
    - const pageUrl = "/company.html"
    - const mainClass = "company"
block main
    include ../../blocks/modules/page-title/page-title--company

    include ../../blocks/modules/factoid/factoid

    include ../../blocks/modules/management/management

    section.company__services
        .container
            h2#service Услуги компании
            p.subtitle Компания «Метриум» предлагает уникальную систему сервисов для инвестиций в высокобюджетную недвижимость по Москве и Московской области.
            .company__services-grid
                each card in pages.company.services
                    +card-services(card)
                +card-service-highlighted({
                    title: 'Свяжитесь с нами',
                    desc: 'Наши эксперты проконсультируют по услугам и любым вопросам, связанным с элитной недвижимостью!',
                    icon: '/img/icons/icon-subcategory/25-metrium-2.svg'
                })
        include ../../blocks/modules/all-categories/categories--company

    section.partners
        .container
            h2#partners Наши партнёры
            .company__partners
                picture.partner: img(src="/img/company/logo00.png" alt="Level group")
                picture.partner: img(src="/img/company/logo01.png" alt="MR group")
                picture.partner: img(src="/img/company/logo02.png" alt="Stone")
                picture.partner: img(src="/img/company/logo03.png" alt="VOS'HOD")
                picture.partner: img(src="/img/company/logo04.png" alt="Mirum")
                picture.partner: img(src="/img/company/logo05.png" alt="Аеон девелопмент")
                picture.partner: img(src="/img/company/logo06.png" alt="OCtober Group")
                picture.partner: img(src="/img/company/logo07.png" alt="Villagio")

    section.company__awards
        .container
            include ../../blocks/modules/awards/awards

    section.company__contacts
        .container
            include ../../blocks/modules/contacts/contacts
block append scripts
    script(src="https://api-maps.yandex.ru/v3/?apikey=0e00c58a-2691-4220-95a9-f61fbbb73582&lang=ru_RU")
