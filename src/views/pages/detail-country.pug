extends ../layouts/page

include ../../blocks/components/breadcrumbs/breadcrumbs
include ../../blocks/modules/special-offers/special-offers
include ../../blocks/modules/form-question/form-question
include ../../blocks/modules/recently-viewed/recently-viewed
include ../../blocks/modules/detail-apartament/detail-apartament

block variables
    - const title = "Квартира в ЖК Дворянское гнездо - Metrium"
    - const pageUrl = "/city.html"
    - const bodyClass = "detail-apartment cityplace"

block main
    include ../../blocks/modules/page-title/page-title--country-detail

    .cityplace-wrp
        .cityplace__grid.container
            +gallery-big({
                base: "/img/country-detail/",
                images: ["img01.jpg", "img02.jpg", "img03.jpg", "img04.jpg", "img05.jpg", "img06.jpg", "img07.jpg", "img08.jpg", "img09.jpg", "img10.jpg"],
                badges: [{text: "Эксклюзив", class: "gold"}, {
                    text: "Старт продаж",
                    class: "green"
                }, {text: "Дизайнерский интерьер", class: "white"}]
            })
            div.cityplace__sticky-wrp
                .sticky-content
                    +passport-detail({
                        params: [["Площадь дома", "740 м²"],["Площадь участка","20.5 соток"]]
                    })
                    include ../../blocks/modules/call-form/call-form
            section.cityplace__anchors
                +anchors-block([
                    {anchor: "description", title: "Описание", active: true},
                    {anchor: "props", title: "Характеристики"},
                    {anchor: "infrastructure", title: "Инфраструктура"}
                ])
            section.cityplace__content
                article.cityplace__description#description
                    h4 Описание
                    p Предлагается светлый пентхаус в клубном доме на Остоженке. Квартира жилой площадью 246 кв. м с выходом на террасу 90 кв. м. Благодаря большому количеству окон легко планируется кухня, гостиная, столовая группа, три спальни со своими ванными комнатами и гардеробными, кабинет, гостевой санузел. Приятные виды из окон на исторический центр города. Лифт привезет хозяина прямо в квартиру, допуск по индивидуально запрограммированному ключу. В подземном паркинге машиноместо.
                article#props.cityplace__description
                    h4 Об объекте недвижимости
                    +dotted-list([
                        ["Тип недвижимости", "Пентхаус"],
                        ["Новостройка или вторичка", "Вторичка"],
                        ["Готовность", "Готов"],
                        ["Метро", "Смоленская"],
                        ["Площадь", "201 м²"],
                        ["Комнат", "6"],
                        ["Этаж", "4/9"],
                        ["Спален", "3"],
                        ["Санузлов", "3"],
                        ["Уровней", "2"],
                        ["Высота потолков", "3,5 м"],
                        ["Терраса", "Есть"]
                    ])
                    h4 О жилом комплексе
                    +dotted-list([
                        ["Площадь объектов от", "105.10 м²"],
                        ["Тип недвижимости", "Квартиры"],
                        ["Объектов в комплексе", "24"],
                        ["Этажность", "7"],
                        ["Потолки", "3.5  — 5 м"],
                        ["Паркинг", "Да"]
                    ])
                    a.link-more(href="#")
                        span Ещё 23 объекта в этом ЖК
                        +icon("ic_chevron-right")

                +form-question({
                    title: "Не подошли характеристики?",
                    description: "Эксперты «Метриум Премиум» помогут найти подходящие варианты, которые удовлетворят ваши пожелания!",
                    class: "nested"
                })

                article.cityplace__map-block#infrastructure
                    h4 На карте и инфраструктура
                    .cityplace__map-legend.hide-before-md
                        +dotted-list([
                            ["Город", "Москва"],
                            ["Район", "Хамовники"],
                            ["Округ", "ЦАО"],
                            ["Адрес", "Большой Лёвшинский пер., 11"]
                        ])
                    +ymap-static("37.620070,55.753630", "12")

    +recently-viewed({
        title: 'Похожие предложения',
        class: 'similar'
    })
    +special-offers({title: "Подборки городской недвижимости", class: "city-page"})
    +recently-viewed()
    +form-question({
        title: "Затрудняетесь с выбором?",
        description: "Эксперты «Метриум Премиум» помогут вам и сэкономят время без предоплаты и комиссии!",
        class: "dark-bg slim"
    })
block append scripts
    script(src="https://api-maps.yandex.ru/v3/?apikey=0e00c58a-2691-4220-95a9-f61fbbb73582&lang=ru_RU")
