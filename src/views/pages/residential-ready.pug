extends ../layouts/page
include ../../blocks/components/index
include ../../blocks/components/form/form
include ../helpers/mixins

block variables
    - const title = "Дворянское гнездо - Metrium"
    - const pageUrl = "/city.html"
    - const bodyClass = "residentials"
block main
    section
        .container
            +breadcrumbs([
                {url: "/city.html", title: "Элитная недвижимость в Москве"},
                {url: "/residentials.html", title: "Жилые комплексы"},
                {url: "/residential-ready.html", title: "Дворянское гнездо"}
            ])
    section.page-title
        .container
            h2 Дворянское гнездо
            .get-to
                ul
                    li
                        +icon('ic_metro')
                        span Смоленская
                    li
                        span Москва, Большой Лёвшинский переулок, 11
                a.get-to__map(href="#")
                    +icon('ic_on-map-small')
                    span На карте
    .residentials-wrp
        .residentials__grid.container
            include ../../blocks/modules/gallery/gallery-big
            div.residentials__sticky-wrp
                .sticky-content
                    include ../../blocks/modules/passport/passport
                    include ../../blocks/modules/call-form/call-form
            section.residentials__anchors
                +anchors-block([
                    {anchor: "description", title: "Описание", active: true},
                    {anchor: "estates", title: "Недвижимость"},
                    {anchor: "infrastructure", title: "Инфраструктура"}
                ])
            section.residentials__content
                article.residentials__description
                    h4 О жилом комплексе Дворянское гнездо
                    p ЖК Дворянское гнездо, выстроенный в стиле неоклассической архитектуры, имеет семь этажей и всего 25 квартир, площадь которых варьирует в пределах диапазона 150-500 квадратных метров.
                    p ЖК «Дворянское гнездо» — это современный жилой комплекс, сочетающий в себе комфорт, качество и элегантность. Расположенный в престижном районе, он предлагает жильцам просторные квартиры с продуманными планировками и высококачественной отделкой. Архитектура комплекса выдержана в классическом стиле с элементами современного дизайна, что придает ему благородный и уютный облик.
                    p На последнем уровне дома находятся пентхаусы, а на первом — сауны, тренажерный зал с бассейном, просторный вестибюль и холл для ожидания. Поскольку возле особняка нет высоких строений, его окна обеспечивают внутренним помещениям полноценное естественное освещение. На северной стороне ЖК Дворянского гнезда имеется внутренний двор обустроенным ландшафтом и площадкой для детей.
                    +dotted-list([
                        ["Площадь объектов от","105.10 м²"],
                        ["Потолки","3.5  — 5 м"],
                        ["Тип недвижимости", "Квартиры"],
                        ["Паркинг", "Да"],
                        ["Объектов в комплексе", "24"],
                        ["Готовность", "Строится"],
                        ["Этажность", "7"],
                        ["Срок сдачи", "3 квартал 2027"]
                    ])

                article.residentials__filter
                    form
                        .residentials__input
                            +select-field({
                                placeholder: "Тип сделки",
                                options: ["Тип сделки 001", "Тип сделки 002", "Тип сделки 003"]
                            })
                        .residentials__input
                            +select-field({
                                placeholder: "Тип недвижимости",
                                options: ["Тип недвижимости 001", "Тип недвижимости 002", "Тип недвижимости 003"]
                            })
                        .residentials__input
                            +select-field({
                                multiple: true,
                                placeholder: "Спален",
                                options: ["1", "2", "3", "4"]
                            })
                        +select-range-units({
                            placeholder: "Цена",
                            range: [0],
                            units: [["RUB","₽"],["USD","$"],["EUR","€"]]
                        })
                h3 list
                h2 list-header
                h2 list-content
                h2 list-footer
                article
                    h2 map
