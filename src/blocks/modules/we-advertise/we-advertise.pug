include ./adv-step
section.we-adv
    .container
        h2 Как мы рекламируем объект
        .we-adv__grid
            +advStep({number: "01", title: "Маркетинговая стратегия", text: "Разработка стратегии маркетингового продвижения объекта недвижимости"})
            +advStep({number: "02", title: "Создание фото и видеоматериалов", text: "Профессиональная фотосессия и видеосъемка объекта"})
            +advStep({number: "03", title: "E-mail и SMS рассылки", text: "По нашей обширной базе VIP-клиентов и партнёров"})
            +advStep({number: "04", title: "Реклама в сообществах", text: "Прорекламируем в закрытых сообществах и Telegram-каналах"})
            +advStep({number: "05", title: "Создание лэндинга", text: "Сайта с уникальным дизайном и наполнением"})
            +advStep({number: "06", title: "Выгрузка на сайт", text: "Ваши объекты всегда на виду у нас на сайте Metrium.ru"})
            +advStep({number: "07", title: "Размещение объекта в ТОП", text: "На популярных платформах Cian, Я.Недвижимость, Авито, Domofond и др."})
            +advStep({number: "08", title: "Реклама в социальных сетях", text: "Видео-презентация, креативы, шортсы — все методы продвижения"})
            +advStep({number: "09", title: "Контекстная реклама", text: "В поисковых системах Яндекс и Google ключевые запросы на первых позициях"})
