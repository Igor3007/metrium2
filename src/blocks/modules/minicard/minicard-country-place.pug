mixin minicard-countryplace(data)
    -var image = data.image
    -var id = data?.id || 23479
    -var stickers = data?.stickers || []
    -var price = data?.price || "725 320 000 ₽"
    -var sample = data?.sample || 0
    .minicard-wrapper
        .minicard.minicard-cityplace
            .minicard__top
                .minicard__stickers
                    ul
                        each sticker in stickers
                            li: span(style=`background: ${sticker.color}`)= sticker.title

                .minicard__fullscreen: +icon('ic_fullscreen')
                .minicard__counter
                    span(data-slider-counter="current") 2
                    | /
                    span(data-slider-counter="total") 12
                .minicard__nav
                    .minicard__nav-prev(data-slider-prev="minicard"): +icon('ic_arr-left')
                    .minicard__nav-next(data-slider-next="minicard"): +icon('ic_arr-right')
                .minicard__slider
                    .splide(data-slider="minicard")
                        .splide__track
                            .splide__list
                                .splide__slide
                                    +picture(image)
                                .splide__slide
                                    +picture('/img/objects/img-block-4')
                                each item in [1,1,1,1,1,1]
                                    .splide__slide
                                        +picture(image)
            .minicard__main
                .minicard__wishlist
                    span(data-wishlist=id): +icon('ic_heart')
                .minicard__id ID:&nbsp;
                    = id
                .minicard__params
                    .minicard__place
                        .minicard__jk
                            +icon('ic_country', 28)
                            a(href="#") Дворянское гнездо
                        .minicard__address
                            ul
                                li ЗАО
                                li Раменка
                                li Мосфильмовская улица
                        .minicard__stations
                            +icon('ic_stations')
                            span Пушкинская, Тверская, Чеховская
                        .minicard__estate-list
                            if sample > 0
                                ul
                                    li: a(href="#")
                                        span.desc Коттеджи от 180.20 м²
                                        span.price 308 286 000 ₽
                                    if sample > 1
                                        li: a(href="#")
                                            span.desc Участки от 16,5 сот
                                            span.price 332 548 000 ₽
                                        li: a(href="#")
                                            span.desc Виллы от 255.90 м²
                                            span.price 253 927 000 ₽
                                if sample > 1
                                    a.show-all(href="#") Смотреть все 36 предложений
                            else
                                .minicard__estate-list--empty Информацию о доступных объектах<br/>уточняйте у менеджеров

                .minicard__footer
                    .minicard__action
                        .minicard__detail
                            a(href='#'): button.btn.btn-green: span Подробнее
                        .minicard__getcall
                            a(href='#')
                                button.btn.btn-line
                                    +icon('ic_phone')
                                    span Заказать звонок
