.container
    .header
        .header__left
            .header__burger.hover-ripple(data-menu="open")
                .icon-burger
                    span
                    span
            .header__nav
                nav
                    ul.main-menu
                        each item in mainNav
                            li(class={'is-active': item.url === pageUrl})
                                a(href=item.url)= item.title
                                if item.submenu
                                    .submenu-wrapper
                                        .submenu
                                            if item.premenu
                                                ul.submenu-pre
                                                    each _i in item.premenu
                                                        li(class=_i.bg)
                                                            a(href=_i.url)
                                                                if _i.icon
                                                                    +icon(_i.icon.name, 24, _i.icon.color)
                                                                span= _i.title
                                                ul.submenu-main
                                                    each subitem in item.submenu
                                                        li
                                                            a(href=subitem.url)= subitem.title
                                                if item.postmenu
                                                    ul.submenu-post
                                                        each _i in item.postmenu
                                                            li
                                                                a(href=_i.url)= _i.title
        .header__logo
            a(href='#')
                span(style="background-image: url('/img/common/logo.svg')")
                span.logo-color(style="background-image: url('/img/common/logo-color.svg')")
        .header__right
            .header__phone
                a(href='tel:+74952525255') +7(495)25-25-255
            .header__wishlist
                a(href='#' class="hover-ripple"): +icon('ic_heart', 24)
            .header__button
                a(href='#')
                    button.btn.btn-gold
                        +icon('ic_phone')
                        span Позвоните мне
