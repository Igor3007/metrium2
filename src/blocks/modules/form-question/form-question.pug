mixin  form-question(data)
    -var title = data?.title || "Есть вопрос или нужна консультация?"
    -var description = data?.description || "Оставляйте свой номер телефона — мы перезвоним и расскажем о самых выгодных предложениях, поможем подобрать наиболее подходящие варианты для вас!"
    -var className = data?.class || false
    section.section-form-question(class = className)
        .container
            .form-question
                .form-question__main
                    .form-question__title= title
                    .form-question__desc= description
                .form-question__form
                    .form-question__field
                        form(action='#' method='POST' data-send="ajax")
                            .form-question__input
                                input(type="text" placeholder="Ваш номер телефона" data-maska="+7(###)###-##-##" required=true)
                                button.btn
                                    span Отправить
                                    +icon('ic_arrow-right')
                            .form-question__note
                                +checkbox("", "agree", {required: true})
                                span Нажимая кнопку, вы даёте согласие на 
                                a(href='#' target="_blank") обработку персональных данных
