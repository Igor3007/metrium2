-var base = "/img/residentials/"
-var images = ["image00.jpg", "image01.jpg", "image02.jpg", "image03.jpg", "image04.jpg", "image05.jpg", "image06.jpg", "image07.jpg"]
section.gallery-big
    .splide.main
        .splide__track
            ul.splide__list
                for image in images
                    li.splide__slide
                        picture
                            img(src=base+image)
        .gallery-big__controls
            .gallery-big__all
                +icon("ic_fullscreen", 12)
                span Все фото
            .gallery-big__counter
                span 1 / 12
            .gallery-big__arrows
                .arrow.disabled(data-dir="prev")
                    +icon("ic_chevron-left", 12)
                .arrow(data-dir="next")
                    +icon("ic_chevron-right", 12)

    .splide.thumbs
        .splide__track
            ul.splide__list
                for image in images
                    li.splide__slide
                        picture
                            img(src=base + image)
