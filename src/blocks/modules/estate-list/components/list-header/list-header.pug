.list-header
    .list-header__qty
        |Найдено 512 вариантов
    .list-header__controls
        .list-header__controls-sort
            select#sortlist(data-prefix="Сортировать")
                option(value=1) По актуальности
                option(value=2) По возрастанию
            .btn.btn-line(data-selectpopup="#sortlist")
                +icons("#ic_sort")
                |Сортировка

        .list-header__controls-group
            .buttons-group
                button.btn.hide-before-xl.grid(data-remove="list" data-parent=".estate-list")
                    +icons("#ic_grid")
                    span Плиткой
                button.btn.hide-before-xl.list(data-add="list" data-parent=".estate-list")
                    +icons("#ic_list")
                    span Списком
                a(href="/city-map.html").btn
                    +icons("#ic_on-map-small")
                    span На карте

