mixin caseSlide(data)
    - var image = data?.image
    - var title = data?.title || "title"
    - var price = data?.price || "price ₽"
    - var square = data?.square || "square м²"
    - var time = data?.time || "time"
    .case-slide__wrapper.holder
        .case-slide
            picture
                img(src=image)
            .case-slide__description
                .case-slide__title
                    h3= title
                .case-slide__params
                    .case-slide__param
                        .case-slide__param-icon
                            +icon("ic_wallet")
                        .case-slide__param-text
                            .case-slide__param-name
                                span Стоимость
                            .case-slide__param-value
                                span= price
                    .case-slide__param
                        .case-slide__param-icon
                            +icon("ic_room")
                        .case-slide__param-text
                            .case-slide__param-name
                                span Площадь
                            .case-slide__param-value
                                span= square
                    .case-slide__param
                        .case-slide__param-icon
                            +icon("ic_time")
                        .case-slide__param-text
                            .case-slide__param-name
                                span Время продажи
                            .case-slide__param-value
                                span= time
