include ../../../views/helpers/mixins
include ../../../blocks/components/form/form
include ../../../blocks/components/index

.page-filter
    .page-filter__modal-heading.hide-from-md
        h3 Фильтры недвижимости
        button.close(data-target=".page-title__filter" data-toggle="sm-modal")
            +icon("ic_close", 12)
    form(action="#" data-send="ajax-on-change")
        .form.primary-form
            .page-filter__item
                +radio-group(
                    {name: "buy", inline: true},
                    [
                        {title: "Купить", value: "buy", selected: true},
                        {title: "Арендовать", value: "rent"}
                    ]
                )
            .page-filter__item.fix1
                +select-field({
                    placeholder: "Тип недвижимости",
                    options: [
                        "Тип недвижимости 1",
                        "Тип недвижимости 2",
                        "Тип недвижимости 3"
                    ]
                })
            .page-filter__item.fix1
                +select-field({
                    placeholder: "Новостройки и вторичка",
                    options: [
                        "Новостройки",
                        "Вторичка"
                    ]
                })
            .page-filter__item.fix2
                +radio-group(
                    {name: "ready", legend: "Готовность:"},
                    [
                        {title: "Неважно", value: "any", selected: true},
                        {title: "Готов", value: "yes"},
                        {title: "Строится", value: "no"}
                    ]
                )
            .page-filter__item
                +select-range({
                    label: "Спален",
                    options: [" ",1, 2, 3, 4, 5]
                })
            .page-filter__item
                +select-range({
                    label: "Комнат",
                    options: [" ", 1, 2, 3, 4, 5]
                })
            .page-filter__group.page-filter__item
                .page-filter__item
                    +prefixed-input({maska: "###############"})
                        label Цена от
                .page-filter__item
                    +prefixed-input({maska: "###############"})
                        label до
                .page-filter__item
                    +radio-group(
                        {name: "currency"},
                        [
                            {title: "₽", value: "RUB", selected: true},
                            {title: "$", value: "USD"},
                            {title: "€", value: "EU"}
                        ]
                    )
            .page-filter__group.fix3
                .page-filter__item
                    +prefixed-input({maska: "######"})
                        label Площадь от (м²)
                .page-filter__item
                    +prefixed-input({maska: "######"})
                        label до
            .page-filter__item.fix4
                +district-selector({
                    placeholder: "Выберите район",
                    pluralTemplate: "Выбран {{n}} район, Выбраны {{n}} района, Выбраны {{n}} районов"
                })
            .page-filter__item.fix4
                +select-field({
                    multiple: true,
                    placeholder: 'Метро',
                    options: catalog.metro,
                    pluralTemplate: "Выбрана {{n}} станция, Выбраны {{n}} станции, Выбраны {{n}} станций"
                })
            .page-filter__item.fix4
                +select-field({
                    multiple: true,
                    placeholder: 'Жилищные комплексы',
                    options: catalog.ZHK,
                    pluralTemplate: "Выбран {{n}} ЖК, Выбраны {{n}} ЖК, Выбраны {{n}} ЖК"
                })
        .form.secondary-form
            .page-filter__item.full
                h4 Дополнительные параметры объекта
            .page-filter__item.full
                +prefixed-input({placeholder: "Поиск по ID"})
                    +icon("ic_search",28,"icon-search")
            .page-filter__item
                +radio-group(
                    {name: "levels", legend: "Уровней:"},
                    [
                        {title: "1", value: "1"},
                        {title: "2", value: "2"},
                        {title: "3+", value: "3"}
                    ]
                )
            .page-filter__item
                +radio-group(
                    {name: "ceilings", legend: "Потолки:"},
                    [
                        {title: "до 3 м", value: "-3"},
                        {title: "3-5 м", value: "3-5"},
                        {title: "Более 5 м", value: "5+"}
                    ]
                )
            .page-filter__item
                +radio-group(
                    {name: "wcs", legend: "Санузлов:"},
                    [
                        {title: "1", value: "1"},
                        {title: "2", value: "2"},
                        {title: "3+", value: "3"}
                    ]
                )
            .page-filter__item.full
                +checkbox("Терраса", "terrace")

        .page-filter__instant-filter
            .instant-filter.fb-filter__selections(data-collection="flex")
                .instant-filter__title Быстрый поиск
                ul.instant-filter__list
                    li: a(href='#') Купить участок в Подмосковье
                    li: a(href='#') Сервисные апартаменты
                    li: a(href='#') Квартиры с террасами
                    li: a(href='#') Патриаршие пруды
                    li: a(href='#') Квартиры для большой семьи
                    li: a(href='#') Сервисные апартаменты
                    li: a(href='#') Квартиры с террасами
                    li: a(href='#') Патриаршие пруды
                    li: a(href='#') Квартиры для большой семьи
                    div(class="fb-filter__more show-more-tag" data-isopen="tag-collections"): span
        .page-filter__footer
            .btn-wrapper
                .hide-before-md.filter-toggle
                    +toggler-tick({
                        title: ["Дополнительный фильтр", "Простой фильтр"],
                        toggle: "open",
                        target: ".secondary-form"
                    })
                button.btn.btn-green(type="submit").hide-from-md
                    span Применить фильтры
                button.btn.btn-transparent.btn-reset(type="reset" data-remove="sm-modal" data-target=".page-title__filter" data-prevent="none")
                    span Сбросить фильтры
                    +icon("ic_close", 12)
