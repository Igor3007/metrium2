mixin page-details
    .page-details
        .page-details__jk: a(href='#') Дворянское гнездо
        .page-details__metro
            a(href='#')
                +icon('ic_metro') 
                span Смоленская
        .page-details__address Москва, Большой Лёвшинский переулок, 11
        .page-details__inmap
            a(href='#')
                +icon('ic_on-map-small')
                span На карте