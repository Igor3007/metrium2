include ../../../views/helpers/mixins
include ../../../blocks/components/form/form

section.page-title
    +breadcrumbs([{url: "", title: "Элитная недвижимость в Москве"}])
    h1 Элитная недвижимость в Москве
    .page-title__filter
        .btn-wrapper.toggler
            button.btn.btn-gold(data-target=".page-title__filter" data-toggle="sm-modal")
                +icons('#ic_filters')
                span Фильтры недвижимости
        .page-filter
            .page-filter__modal-heading.hidden-from-md
                h4 Фильтры недвижимости
                button.close(data-target=".page-title__filter" data-toggle="sm-modal")
                    +icons("#ic_close", 12)
            form
                .form.primary-form
                    .page-filter__item.sm
                        +radio-group(
                            {name: "buy", inline: true},
                            [
                                {title: "Купить", value: "buy", selected: true},
                                {title: "Арендовать", value: "rent"}
                            ]
                        )
                    .page-filter__item.md
                        +select-field({
                            placeholder: "Тип недвижимости",
                            options: [
                                "321",
                                "123",
                                "213"
                            ]
                        })
                    .page-filter__item.md
                        +select-field({
                            placeholder: "Новостройки и вторичка",
                            options: [
                                "321",
                                "123",
                                "213"
                            ]
                        })
                    .page-filter__item
                        +radio-group(
                            {name: "ready", legend: "Готовность:"},
                            [
                                {title: "Неважно", value: "any", selected: true},
                                {title: "Готов", value: "yes"},
                                {title: "Строится", value: "no"}
                            ]
                        )
                    .page-filter__item
                        +checkbox-group(
                            {name: "bedrooms", legend: "Спален:"},
                            [
                                {title: "1", value: "1"},
                                {title: "2", value: "2"},
                                {title: "3", value: "3"},
                                {title: "4", value: "4"},
                                {title: "5+", value: "5"}
                            ]
                        )
                    .page-filter__group
                        .page-filter__item.lg
                            +prefixed-input({format: true})
                                label Цена от
                        .page-filter__item.lg
                            +prefixed-input()
                                label до
                        .page-filter__item
                            +radio-group(
                                {name: "currency"},
                                [
                                    {title: "₽", value: "RUB", selected: true},
                                    {title: "$", value: "USD"},
                                    {title: "€", value: "EU"}
                                ]
                            )
                    .page-filter__group
                        .page-filter__item.md
                            +prefixed-input()
                                label Площадь от (м²)
                        .page-filter__item.md
                            +prefixed-input()
                                label до
                    .page-filter__item.md
                        +select-field({
                            multiple: true,
                            placeholder: 'Район',
                            options: catalog.districts
                        })
                    .page-filter__item.hidden-from-md
                        +select-field({
                            multiple: true,
                            placeholder: 'Метро',
                            options: catalog.metro
                        })
                    .page-filter__item.md
                        +select-field({
                            multiple: true,
                            placeholder: 'ЖК',
                            options: catalog.ZHK
                        })
                .form.secondary-form
                    .page-filter__item.full
                        h4 Дополнительные параметры объекта
                    .page-filter__item
                        +prefixed-input({placeholder: "Поиск по ID"})
                            +icons("#ic_search",28,"icon-search")
                    .page-filter__item
                        +radio-group(
                            {name: "levels", legend: "Уровней:"},
                            [
                                {title: "1", value: "1"},
                                {title: "2", value: "2"},
                                {title: "3+", value: "3"}
                            ]
                        )
                    .page-filter__item
                        +radio-group(
                            {name: "ceilings", legend: "Потолки:"},
                            [
                                {title: "до 3 м", value: "-3"},
                                {title: "3-5 м", value: "3-5"},
                                {title: "Более 5 м", value: "5+"}
                            ]
                        )
                    .page-filter__item
                        +radio-group(
                            {name: "wcs", legend: "Санузлов:"},
                            [
                                {title: "1", value: "1"},
                                {title: "2", value: "2"},
                                {title: "3+", value: "3"}
                            ]
                        )
                    .page-filter__item
                        +radio-group(
                            {name: "rooms", legend: "Комнат:"},
                            [
                                {title: "1", value: "1"},
                                {title: "2", value: "2"},
                                {title: "3", value: "3"},
                                {title: "4", value: "4"},
                                {title: "5+", value: "5"}
                            ]
                        )
                    .page-filter__item.full
                        +checkbox("Терраса", "terrace")

                .page-filter__instant-filter
                    .instant-filter.fb-filter__selections(data-collection="flex")
                        .instant-filter__title Быстрый поиск
                        ul.instant-filter__list
                            li: a(href='#') Купить участок в Подмосковье
                            li: a(href='#') Сервисные апартаменты
                            li: a(href='#') Квартиры с террасами
                            li: a(href='#') Патриаршие пруды
                            li: a(href='#') Квартиры для большой семьи
                            li: a(href='#') Сервисные апартаменты
                            li: a(href='#') Квартиры с террасами
                            li: a(href='#') Патриаршие пруды
                            li: a(href='#') Квартиры для большой семьи
                            div(class="fb-filter__more show-more-tag" data-isopen="tag-collections"): span
                .page-filter__footer
                    .btn-wrapper
                        button.btn.btn-green(type="submit")
                            span Применить фильтры
                        button.btn.btn-transparent(type="reset")
                            span Сбросить фильтры
                            +icons("#ic_close", 12)
