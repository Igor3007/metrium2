section.calc-request
    .container
        .calc-form__wrapper(style="background-image:url(/img/owners/ctabg.jpg)")
            form.calc-form.v-flex
                .calc-form__header
                    h3 Оставьте заявку для бесплатного расчёта стоимости
                    .calc-form__subtitle Заполните поля ниже и мы свяжемся с вами по расчёту в течение 15 минут!
                .calc-form__inputs.flex
                    .input-wrapper.v-flex
                        label Ваш телефон
                        input(required="required" placeholder="Введите номер *" data-maska="+7(###)###-##-##")
                    .input-wrapper.v-flex
                        label Ваше имя
                        input(required="required" placeholder="Имя *" maxlength=50)
                .btn-wrapper
                    button.btn.btn-green.btn-wide
                        +icon("ic_house-plus")
                        span Оставить заявку
                    .flex
                        label.checkbox
                            input(type='checkbox' name='agree' required='required')
                            span.checkbox__elem
                            span.checkbox__text
                            span
                                | Даю согласие на обработку
                                a(href='#' target='_blank')  персональных данных

