include ../../components/slider-nav/slider-nav
include ../minicard/minicard

mixin recently-viewed(data)
    - var className = data?.class || false
    - var title = data?.title || "Недавно просмотренные"

    section.recently-viewed(class= className)
        .container
            .recently-viewed__header
                h3.recently-viewed__title= title
                +slider-nav({sliderName: "viewed", class: "hide-before-md"})
            .recently-viewed__slider
                .splide(data-slider="viewed")
                    .splide__track
                        .splide__list
                            each card in sets.cards01
                                .splide__slide
                                    +minicard(card)
